{
  "manifest_version": 3,
  "name": "灵阅AI助手",
  "version": "0.8.0",
  "key": "",
  "description": "灵阅AI助手｜一键唤起智能侧边栏，与当前网页对话：即时问答、要点提炼、全文翻译，还能代你完成点击、填写等页面操作。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "debugger", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/translate.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "side-assistant@local" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开灵阅AI助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}